# ─────────────────────────────────────────────────────────────
# Pre-Legal Document Generator — Environment Variable Reference
# ─────────────────────────────────────────────────────────────
# Copy this file to .env (at root, /backend, or /frontend as
# appropriate) and fill in the values for your environment.
# NEVER commit .env files with real secrets.

# ── Frontend ──────────────────────────────────────────────────
# URL of the running backend API (no trailing slash, no /api prefix).
# Default for local dev: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend — Future use (post-MVP persistence) ───────────────
# Uncomment and set when a database is wired up (PL-8 post-MVP).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prelegal

# ── Backend — Future use (post-MVP authentication) ────────────
# Uncomment and set when JWT auth is added.
# JWT_SECRET_KEY=change-me

# ── Production overrides ──────────────────────────────────────
# FRONTEND_URL=https://your-vercel-app.vercel.app
# SUPABASE_URL=
# SUPABASE_KEY=
